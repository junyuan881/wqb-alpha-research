# Copy this file to .env. Do NOT commit real credentials.

# ---------- LLM ----------
# OpenAI API key used only by `python run.py research --llm-provider openai ...`
OPENAI_API_KEY=your_openai_api_key
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6
LLM_REQUEST_TIMEOUT=180
# Optional override for OpenAI-compatible routing/proxy:
# OPENAI_API_BASE=https://api.openai.com/v1

# ---------- WorldQuant BRAIN ----------
WQB_USERNAME=your_email@example.com
WQB_PASSWORD=your_password

# Optional runtime tuning
WQB_REQUEST_TIMEOUT=30
WQB_SESSION_CACHE_HOURS=3.5
WQB_SIMULATION_LIMIT=3
WQB_MULTI_SIMULATION_SIZE=10
